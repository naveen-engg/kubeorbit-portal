# Copy to .env for local development (python-dotenv loads it automatically).
# See README.md for full explanations.

# ---- Core ------------------------------------------------------------------
KUBEORBIT_CONFIG_PATH=config/clusters.yaml
KUBEORBIT_LOG_LEVEL=INFO
KUBEORBIT_KUBECONFIG_HOME=~/.kubeorbit/kubeconfigs
KUBEORBIT_CORS_ORIGINS=http://localhost:8080

# ---- Portal auth mode --------------------------------------------------
# none      -- no portal auth (local dev only)
# api_key   -- shared secret via X-API-Key header (KUBEORBIT_API_KEY below)
# iap       -- trust GCP Identity-Aware Proxy headers (deploy behind IAP)
# azure_ad  -- trust Azure App Service/Container Apps Easy Auth headers
KUBEORBIT_AUTH_MODE=none
KUBEORBIT_API_KEY=
KUBEORBIT_IAP_AUDIENCE=
# 3-Tier RBAC (GCP Custom IAM Roles + Explicit Email Allowlists)
KUBEORBIT_GCP_IAM_RBAC=false
KUBEORBIT_STRICT_RBAC=false
KUBEORBIT_ADMIN_EMAILS=
KUBEORBIT_OPERATOR_EMAILS=
KUBEORBIT_VIEWER_EMAILS=

# ---- GCP / GKE ---------------------------------------------------------
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- AWS / EKS -----------------------------------------------------------
AWS_PROFILE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- Azure / AKS -----------------------------------------------------------
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ---- "Diagnose with AI" & "Ask AI" (Google ADK + Pluggable LLMs) -----------
# Active provider: vertex_ai (default) | gemini | claude (placeholder) | openai (placeholder)
KUBEORBIT_AI_PROVIDER=vertex_ai

# Option 1 (Active / Recommended): Vertex AI Gemini in your GCP Project (zero API keys --
# uses `gcloud auth application-default login` locally or the Cloud Run Service Account):
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=adk-enterprise-observability
GOOGLE_CLOUD_LOCATION=global
KUBEORBIT_AI_MODEL=gemini-3.5-flash

# Option 2 (Active fallback): Google AI Studio API Key (set KUBEORBIT_AI_PROVIDER=gemini)
GOOGLE_API_KEY=

# Option 3 (Placeholder): Anthropic Claude via Google ADK LiteLLM bridge
# Requires `pip install litellm`, KUBEORBIT_AI_PROVIDER=claude, and ANTHROPIC_API_KEY:
# KUBEORBIT_AI_MODEL=anthropic/claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# Option 4 (Placeholder): OpenAI via Google ADK LiteLLM bridge
# Requires `pip install litellm`, KUBEORBIT_AI_PROVIDER=openai, and OPENAI_API_KEY:
# KUBEORBIT_AI_MODEL=openai/gpt-4o
OPENAI_API_KEY=
