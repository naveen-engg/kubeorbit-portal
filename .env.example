# Copy to .env for local development (python-dotenv loads it automatically
# if you `import dotenv; dotenv.load_dotenv()` -- or just `export`/set these
# in your shell / deployment platform). See README.md for full explanations.

# ---- Core ------------------------------------------------------------------
KUBEORBIT_CONFIG_PATH=config/clusters.yaml
KUBEORBIT_LOG_LEVEL=INFO
KUBEORBIT_KUBECONFIG_HOME=~/.kubeorbit/kubeconfigs
KUBEORBIT_CORS_ORIGINS=http://localhost:8000

# ---- Portal auth mode --------------------------------------------------
# none      -- no portal auth (local dev only)
# api_key   -- shared secret via X-API-Key header (KUBEORBIT_API_KEY below)
# iap       -- trust GCP Identity-Aware Proxy headers (deploy behind IAP)
# azure_ad  -- trust Azure App Service/Container Apps Easy Auth headers
KUBEORBIT_AUTH_MODE=none
KUBEORBIT_API_KEY=

# ---- GCP / GKE ---------------------------------------------------------
# Local dev: run `gcloud auth login` and `gcloud auth application-default
# login` once; KubeOrbit shells out to your already-authenticated gcloud CLI.
# Only set this if you want every GKE cluster to impersonate the same SA by
# default (per-cluster override: config.impersonate_service_account in
# clusters.yaml).
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=
# For Cloud Run/production, prefer attaching a service account to the
# revision over a downloaded JSON key. If a key file is unavoidable:
GOOGLE_APPLICATION_CREDENTIALS=

# ---- AWS / EKS -----------------------------------------------------------
# Local dev: run `aws configure` or `aws sso login` once; KubeOrbit shells out
# to your already-authenticated AWS CLI. Set a profile only if you don't want
# the default profile used, or set it per-cluster via config.aws_profile.
AWS_PROFILE=
AWS_REGION=
# Only needed if you are not using `aws configure`/SSO (e.g. CI runners):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- Azure / AKS -----------------------------------------------------------
# Local dev: run `az login` and `az account set --subscription <id>` once.
# For clusters whose config sets `service_principal_env_prefix: "TEAM_ENV_"`,
# define that team/environment's own triplet, e.g.:
#   PLATFORM_PROD_AZURE_CLIENT_ID=...
#   PLATFORM_PROD_AZURE_CLIENT_SECRET=...
#   PLATFORM_PROD_AZURE_TENANT_ID=...
# Unprefixed fallback (used if a cluster sets no prefix and you still want
# non-interactive login, e.g. in CI):
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ---- "Diagnose with AI" (ai_agent.py) -------------------------------------
# Leave both unset to leave the feature disabled (it fails closed with a
# clear error, never fabricates an answer). KUBEORBIT_AI_MODEL's value picks
# which provider is used -- google-adk resolves it from the name alone:
#
#   Claude (Anthropic Console: https://console.anthropic.com/settings/keys)
#     ANTHROPIC_API_KEY=sk-ant-...
#     KUBEORBIT_AI_MODEL=claude-haiku-4-5-20251001   # cheapest current Claude tier
#
#   Gemini (Google AI Studio: https://aistudio.google.com/apikey)
#     GOOGLE_API_KEY=...
#     KUBEORBIT_AI_MODEL=gemini-3.1-flash-lite        # cheapest current Gemini tier (default if unset)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
KUBEORBIT_AI_MODEL=
